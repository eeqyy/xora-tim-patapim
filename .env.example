# ============================================================
# XORA — Contoh konfigurasi environment (salin menjadi .env)
# ============================================================
#   cp .env.example .env
# Root `.env` adalah SUMBER TUNGGAL untuk backend (dibaca via
# backend/db.js & index.js). File `backend/.env` tidak wajib.
# ============================================================

# ==== Port & Aplikasi ====
# 5001 dipakai karena 5000 ditempati macOS ControlCenter (AirPlay).
PORT=5001
BACKEND_PORT=5001
FRONTEND_PORT=5173

# ==== PostgreSQL ====
# SSL: AKTIF secara default (untuk database remote seperti Supabase).
# Untuk Postgres LOKAL, WAJIB set DATABASE_SSL=false.
#
# A. Pengembangan LOKAL (Postgres Homebrew) — tanpa SSL.
#    Buat dulu database-nya:  createdb xora
DATABASE_URL=postgresql://USERNAME@127.0.0.1:5432/xora
DATABASE_SSL=false

# B. PostgreSQL REMOTE (mis. Supabase) — SSL default aktif, jadi tidak wajib diisi.
# DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true

# ==== Kredensial container `postgres` (docker-compose) ====
# Dipakai image postgres & untuk membentuk DATABASE_URL backend di dalam Docker.
POSTGRES_USER=xora_user
POSTGRES_PASSWORD=xora_password
POSTGRES_DB=xora
# Port host yang dipetakan ke Postgres container.
DB_PORT=5432

# ==== CORS Backend ====
# Origin frontend yang diizinkan (Vite dev server).
CLIENT_URL=http://localhost:5173

# ==== AI Provider (OpenRouter — opsional) ====
# Tanpa AI_API_KEY, endpoint /api/ai mengembalikan 503 (fitur lain tetap jalan).
AI_API_KEY=
AI_MODEL=google/gemma-3-27b-it:free
AI_BASE_URL=https://openrouter.ai/api/v1
AI_JSON_MODE=true
AI_TIMEOUT_MS=60000
