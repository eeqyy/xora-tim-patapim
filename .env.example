# ==== Konfigurasi Aplikasi ====
# Port utama aplikasi
APP_PORT=3000
# Port untuk Backend Node.js
BACKEND_PORT=5000
# Port untuk Frontend Vite
FRONTEND_PORT=5173

# ==== Konfigurasi MySQL Container ====
# Password root untuk MySQL
MYSQL_ROOT_PASSWORD=rootpassword
# Nama database yang akan dibuat otomatis saat inisialisasi
MYSQL_DATABASE=project_db
# Username user baru MySQL yang akan dibuat otomatis
MYSQL_USER=project_user
# Password untuk user baru MySQL
MYSQL_PASSWORD=project_password

# ==== Konfigurasi Koneksi Database (Backend) ====
# Host database, diset ke nama service 'mysql' (dari docker-compose)
DB_HOST=mysql
# Port database di-mapping ke luar (contoh jika ingin akses dari software db client)
DB_PORT=3306
# Nama database yang digunakan backend
DB_NAME=project_db
# Username database yang digunakan backend
DB_USER=project_user
# Password database yang digunakan backend
DB_PASSWORD=project_password
