# ============================================================
# XOLEARN — Contoh env frontend (Vite). Salin menjadi `frontend/.env`:
#   cp frontend/.env.example frontend/.env
# ============================================================
# Base URL backend yang dipakai frontend/src/services/api.js.
# Wajib sama dengan PORT backend (default 5001, bukan 5000).
# Tanpa file ini, frontend memakai nilai default yang sama (http://localhost:5001).
VITE_API_URL=http://localhost:5001
