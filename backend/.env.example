# Backend Environment Variables Template
PORT=5000
DATABASE_URL=postgresql://username:password@localhost:5432/xora_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_min_32_characters_here
JWT_EXPIRES_IN=7d

# AI Provider Configuration (OpenRouter)
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3.5-lightning:free
AI_BASE_URL=https://openrouter.ai/api/v1
AI_JSON_MODE=true
AI_REFERRER=
AI_TITLE=
AI_TIMEOUT_MS=60000
