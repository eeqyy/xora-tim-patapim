# ============================================================
# XOLEARN Backend — contoh konfigurasi (opsional)
# ============================================================
# Catatan: backend membaca ROOT `.env` (lihat backend/db.js &
# backend/index.js). File ini hanya referensi bila ingin
# menjalankan backend dengan .env-nya sendiri.
# ============================================================

# Port HTTP backend.
PORT=5001

# Koneksi PostgreSQL.
# SSL AKTIF secara default (untuk remote/Supabase).
# Untuk Postgres LOKAL, set DATABASE_SSL=false.
DATABASE_URL=postgresql://USERNAME@127.0.0.1:5432/xora
DATABASE_SSL=false
# Remote (Supabase), SSL default sudah aktif (boleh dikosongkan):
# DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@HOST:5432/postgres
# DATABASE_SSL=true

# Origin frontend untuk CORS.
CLIENT_URL=http://localhost:5173

# AI Provider (OpenRouter — opsional).
AI_API_KEY=
AI_MODEL=google/gemma-3-27b-it:free
# Secret untuk mengenkripsi API key yang disimpan admin lewat dashboard
# (AES-256-GCM). WAJIB diisi agar fitur /admin/ai bisa menyimpan key.
# Gunakan string acak panjang (mis. `openssl rand -hex 32`). Jangan
# diganti setelah ada key tersimpan — key lama tak bisa didekripsi lagi.
AI_CREDENTIALS_SECRET=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_JSON_MODE=true
AI_TIMEOUT_MS=60000
